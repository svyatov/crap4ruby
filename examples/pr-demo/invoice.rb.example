# frozen_string_literal: true

module Invoice
  def self.quote(zone)
    zone == :local ? 10 : 20
  end

  def self.legacy_adjustment(quantity)
    return 1 if quantity == 1
    return 2 if quantity == 2
    return 3 if quantity == 3
    return 4 if quantity == 4
    return 5 if quantity == 5
    return 6 if quantity == 6

    0
  end
end
