# frozen_string_literal: true

module Invoice
  def self.quote(zone)
    return 10 if zone == :local
    return 12 if zone == :metro
    return 14 if zone == :regional
    return 16 if zone == :remote
    return 18 if zone == :island
    return 24 if zone == :international
    return 30 if zone == :priority

    20
  end

  def self.legacy_adjustment(quantity)
    return 1 if quantity == 1
    return 2 if quantity == 2
    return 3 if quantity == 3
    return 4 if quantity == 4
    return 5 if quantity == 5
    return 6 if quantity == 6

    0
  end
end
