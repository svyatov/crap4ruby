module Crap4Ruby
  VERSION: String
  type score = Float | Rational
  type body_note = :shared_declaration | :shared_trailing_code
  type coverage_note = body_note | :no_measurable_lines | :absent_file
  type coverage_source = String | false | nil

  class Error < StandardError
  end

  class MethodInfo < Data
    attr_reader name: String
    attr_reader namespace: String
    attr_reader complexity: Integer
    attr_reader lines: Array[Integer]?
    attr_reader path: String
    attr_reader line: Integer
    attr_reader coverage_note: body_note?
    attr_reader singleton: bool
    def self.new: (String name, String namespace, Integer complexity, Array[Integer]? lines, String path, Integer line, body_note? coverage_note, bool singleton) -> instance
    alias self.[] self.new
    def with: (?name: String, ?namespace: String, ?complexity: Integer, ?lines: Array[Integer]?, ?path: String, ?line: Integer, ?coverage_note: body_note?, ?singleton: bool) -> instance
  end

  class Entry < Data
    attr_reader name: String
    attr_reader namespace: String
    attr_reader complexity: Integer
    attr_reader coverage: Float?
    attr_reader crap: score?
    attr_reader path: String
    attr_reader line: Integer
    attr_reader coverage_note: coverage_note?
    attr_reader singleton: bool
    def self.new: (String name, String namespace, Integer complexity, Float? coverage, score? crap, String path, Integer line, coverage_note? coverage_note, bool singleton) -> instance
    alias self.[] self.new
    def with: (?name: String, ?namespace: String, ?complexity: Integer, ?coverage: Float?, ?crap: score?, ?path: String, ?line: Integer, ?coverage_note: coverage_note?, ?singleton: bool) -> instance
  end

  class Analyzer
    @coverage: bool
    ITERATING_METHODS: Hash[Symbol, bool]
    def initialize: (?coverage: bool) -> void
    def call: (String source, path: String) -> Array[MethodInfo]
    private
    def discover: (Prism::Node? node, Array[String] scope, bool singleton, String path, ?Array[MethodInfo] methods) -> Array[MethodInfo]
    def discover_class: (Prism::ClassNode | Prism::ModuleNode node, Array[String] scope, bool singleton, String path, Array[MethodInfo] methods) -> void
    def discover_call: (Prism::CallNode node, Array[String] scope, bool singleton, String path, Array[MethodInfo] methods) -> void
    def discover_method: (Prism::DefNode node, Array[String] scope, bool singleton, String path, Array[MethodInfo] methods) -> void
    def discover_block: (Prism::BlockNode block, String name, Array[String] scope, bool singleton, String path, Integer line, Array[MethodInfo] methods) -> void
    def defined_name: (Prism::Node node) -> String?
    def method_owner: (Prism::DefNode node, Array[String] scope) -> Array[String]?
    def qualify: (Prism::Node? node, Array[String] scope, ?declaration: bool) -> Array[String]?
    def decisions: (Prism::Node? node, ?Hash[Symbol, bool] seen, ?target: bool) -> Integer
    def child_decisions: (Prism::Node node, Hash[Symbol, bool] seen, bool target) -> Integer
    def assignment_target?: (Prism::Node node, Prism::Node child, bool target) -> bool
    def decision?: (Prism::Node node) -> bool
    def safe_navigation?: (Prism::Node node, Hash[Symbol, bool] seen) -> bool
    def iteration?: (Prism::Node node) -> bool
    def boundary?: (Prism::Node node) -> bool
    def body_lines: (Prism::Node? node, after: Integer, ending: Prism::Location) -> [Array[Integer]?, body_note?]
    def trailing_code?: (Prism::Location location) -> bool
    def body_end_node: (Prism::Node node, Array[Integer] excluded) -> Prism::Node
  end

  type json = nil | bool | Integer | Float | String | Array[json] | Hash[String, json]

  class Coverage
    @files: Hash[String, Array[Integer?]]
    def self.load: (String path, root: String) -> Coverage
    def initialize: (json suites, root: String) -> void
    def measure: (MethodInfo method) -> [Rational?, coverage_note?]
    private
    def add_suite: (json suite, String root) -> void
    def add_file: (String path, json data, String root) -> void
  end

  module Discovery
    EXCLUDED: Array[String]
    def self.call: (root: String, source_roots: Array[String], paths: Array[String], changed: bool) -> Array[String]
    def self.selection_roots: (String root, Array[String] source_roots, Array[String] existing) -> Array[String]
    def self.walk: (String root) -> Array[String]
    def self.git: (String root, *String arguments) -> String
    def self.changed_files: (String root) -> Array[String]
  end

  module Score
    def self.call: (MethodInfo method, Coverage? coverage) -> Entry
  end

  module Batch
    type worker = [IO, Integer?, IO]
    def self.call: (Array[String] files, Coverage? coverage, ?jobs: Integer?) -> Array[Entry]
    def self.worker_count: (Integer size, Integer? jobs) -> Integer
    def self.serial: (Array[String] files, Coverage? coverage) -> Array[Entry]
    def self.parallel: (Array[String] files, Coverage? coverage, Integer count) -> Array[Entry]
    def self.start_worker: (Array[String] files, Coverage? coverage, Array[worker] workers) -> void
    def self.run_child: (Array[IO] pipes, Array[String] files, Coverage? coverage, Array[worker] workers) -> void
    def self.child_result: (Array[String] files, Coverage? coverage) -> (Array[Entry] | StandardError)
    def self.receive: (worker worker) -> (Array[Entry] | StandardError)
    def self.decode: (String data) -> Object
    def self.cleanup: (Array[worker] workers) -> void
    def self.reap: (worker worker) -> Process::Status?
    def self.close_pipe: (IO? pipe) -> void
  end

  module Report
    COVERAGE_NOTES: Hash[Symbol, String]
    def self.sorted: (Array[Entry] entries) -> Array[Entry]
    def self.terminal: (Array[Entry] entries, root: String, files: Integer, coverage_source: coverage_source, ?threshold: Integer | score, ?limit: String?, ?verbose: bool) -> String
    def self.table: (Array[Entry] entries, root: String) -> String
    def self.label: (String value) -> String
    def self.edn: (Array[Entry] entries) -> String
    def self.number: (score? value) -> String
    def self.write: (Array[Entry] entries, root: String) -> String
    private
    def self.terminal_entries: (Array[Entry] entries, Array[Entry] filtered, coverage_source source, bool verbose) -> Array[Entry]
    def self.terminal_body: (Array[Entry] entries, bool empty, String limit, String root, bool verbose) -> String
    def self.coverage_summary: (coverage_source source, String root) -> String
    def self.coverage_cell: (Entry entry) -> String
    def self.quantity: (Integer count, String noun) -> String
    def self.relative_path: (String path, String root) -> String
  end

  interface _Output
    def puts: (*String | OptionParser objects) -> nil
    def write: (String text) -> Integer
  end

  class CLI
    type options = { source_roots: Array[String], ?root: String, ?changed: bool, ?coverage: String, ?threshold_label: String,
      ?help: bool, ?version: bool, ?no_coverage: bool, ?no_save: bool, ?existing: bool, ?command: String,
      ?threshold: Rational, ?jobs: Integer, ?verbose: bool, ?json_report: bool, ?revision: String, ?compare: bool,
      ?base_report: String, ?head_report: String, ?enforce: bool, ?limit: Rational, ?min_increase: Rational }
    COMPARISON_FLAGS: Array[Symbol]
    COMPARISON_OPTIONS: Array[Symbol]
    @stdout: _Output
    @stderr: _Output
    def initialize: (?stdout: _Output, ?stderr: _Output) -> void
    def run: (Array[String] arguments) -> Integer
    private
    def parse_options: (Array[String] arguments) -> [options, OptionParser, Array[String]]
    def analyze: (options options, Array[String] paths) -> Integer
    def analysis_output: (Array[Entry] entries, String root, Integer files, coverage_source source, Array[String]? scope, options options) -> String
    def add_comparison_options: (OptionParser cli, options options) -> void
    def nonnegative_number: (String value, String flag) -> Rational
    def compare: (options options, Array[String] paths) -> Integer
    def validate_scan_options: (options options, Array[String] paths) -> void
    def validate_export: (options options, Array[String] paths) -> void
    def validate_options: (options options) -> void
    def threshold_status: (Array[Entry] entries, Rational? threshold) -> Integer
    def load_coverage: (options options, String root, bool empty) -> [Coverage?, coverage_source]
    def run_coverage: (String command, String root, String report) -> void
    def report_stamp: (String path) -> [Integer, Time, Time, Integer]?
  end
end
