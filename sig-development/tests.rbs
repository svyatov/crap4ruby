class BatchProcessTest < Minitest::Test
  @root: String
  def setup: () -> void
  def teardown: () -> void
  def run_program: (String program) { (String output, String error, Process::Status status) -> void } -> void
  def pid_tracer: () -> String
  def test_explicit_workers_preserve_order_and_run_in_children: () -> void
  def test_automatic_workers_are_bounded_and_small_batches_stay_serial: () -> void
  def test_multithreaded_hosts_stay_serial: () -> void
  def test_hosts_without_fork_stay_serial: () -> void
  def test_unimplemented_fork_stays_serial: () -> void
  def test_analysis_errors_keep_serial_order_and_reap_children: () -> void
  def test_parallel_coverage_matches_exact_serial_scores: () -> void
  def test_parallel_filesystem_errors_keep_their_class: () -> void
  def test_abnormal_worker_exit_returns_a_controlled_error: () -> void
  def test_large_payloads_match_serial_entries_without_blocking: () -> void
  def test_invalid_and_missing_payloads_return_controlled_errors: () -> void
  def test_partial_start_failure_reaps_children_before_serial_fallback: () -> void
  def test_interrupt_cancels_and_reaps_running_workers: () -> void
  def test_child_close_failure_does_not_run_inherited_exit_hooks: () -> void
  def test_cli_workers_preserve_reports_snapshots_and_threshold_statuses: () -> void
  def test_cli_worker_failures_preserve_the_previous_snapshot: () -> void
end

class CLITest < Minitest::Test
  @root: String
  @out: StringIO
  @err: StringIO
  def setup: () -> void
  def teardown: () -> void
  def write: (String path, String content) -> String
  def run_cli: (*String arguments) -> Integer
  def snapshot: () -> String
  def git: (*String arguments) -> void
  def test_writes_complexity_only_table_and_snapshot: () -> void
  def test_reads_coverage_and_compares_unrounded_scores: () -> void
  def test_no_save_reports_complexity_without_creating_metrics_directory: () -> void
  def test_no_save_preserves_snapshot_when_threshold_is_uncertain: () -> void
  def test_no_save_reports_coverage_and_measured_threshold_violations: () -> void
  def test_no_save_does_not_create_snapshot_for_empty_selection: () -> void
  def test_preserves_decimal_threshold_precision: () -> void
  def test_requires_unknown_scores_to_fit_the_threshold_at_zero_coverage: () -> void
  def test_prioritizes_measured_violations_over_unknown_scores: () -> void
  def test_rejects_unrepresentable_method_names_without_replacing_snapshot: () -> void
  def test_escapes_control_characters_in_literal_method_names: () -> void
  def test_rejects_negative_thresholds_that_underflow_float_precision: () -> void
  def test_discovers_source_and_prunes_tests_hidden_and_generated_trees: () -> void
  def test_combines_source_roots_paths_and_fragment_filters_without_duplicates: () -> void
  def test_errors_preserve_previous_snapshot: () -> void
  def test_help_version_invalid_options_and_empty_selection: () -> void
  def test_worker_option_preserves_reports_and_rejects_invalid_counts: () -> void
  def test_coverage_command_must_succeed_and_refresh_its_report: () -> void
  def test_changed_files_include_staged_unstaged_untracked_and_renamed_paths: () -> void
  def test_changed_outside_a_repository_fails_without_replacing_snapshot: () -> void
end

