class AnalyzerTest < Minitest::Test
  def test_can_skip_coverage_lines_while_preserving_methods_and_complexity: () -> void
  def test_counts_boolean_assignments_for_each_ruby_target: () -> void
  def analyze: (String source) -> Array[Crap4Ruby::MethodInfo]
  def test_finds_a_method_without_executing_source: () -> void
  def test_resolves_namespaces_and_singleton_methods: () -> void
  def test_counts_decisions_inside_blocks_and_lambdas: () -> void
  def test_preserves_reference_iteration_syntax_rules: () -> void
  def test_counts_loop_case_pattern_and_rescue_decisions: () -> void
  def test_omits_post_test_loop_increments_but_counts_their_predicates: () -> void
  def test_counts_nested_method_decisions_but_excludes_their_coverage_lines: () -> void
  def test_rejects_invalid_source_with_its_location: () -> void
  def test_ignores_keywords_in_comments_and_strings_and_handles_empty_methods: () -> void
  def test_counts_safe_navigation_in_compound_assignments: () -> void
  def test_discounts_repeated_safe_navigation_until_local_assignment: () -> void
  def test_resets_safe_navigation_for_compound_multiple_and_loop_assignments: () -> void
  def test_pattern_and_regexp_bindings_do_not_reset_safe_navigation: () -> void
  def test_visits_unless_else_before_the_main_body_for_reference_discounts: () -> void
  def test_visits_pattern_before_guard_without_counting_the_guard_wrapper: () -> void
  def test_resolves_constant_singleton_classes_and_qualified_self_references: () -> void
  def test_excludes_decisions_in_parameter_defaults: () -> void
  def test_finds_nested_methods_in_parameter_defaults: () -> void
  def test_finds_methods_in_superclass_expressions_in_the_surrounding_scope: () -> void
  def test_skips_dynamic_namespace_subtrees_without_executing_them: () -> void
  def test_finds_literal_define_method_blocks_and_their_nested_definitions: () -> void
end

